{
  "name": "caldero",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run --filter \"@caldero/*\" --parallel dev",
    "dev:web": "vp run --filter @caldero/web dev",
    "build": "vp run --filter \"@caldero/*\" build",
    "repair": "pnpm --filter @caldero/agent repair",
    "retry": "pnpm --filter @caldero/agent retry",
    "status": "pnpm --filter @caldero/agent status",
    "typecheck": "vp run --cache --concurrency-limit 4 --filter \"@caldero/*\" typecheck",
    "test": "vp run --filter \"@caldero/*\" test && node --test tools/effect-policy.test.js",
    "test:browser": "vp run --filter \"@caldero/*\" test:browser",
    "browser:install": "vp run --filter \"@caldero/*\" browser:install",
    "lint": "vp lint .",
    "format": "vp fmt .",
    "format:check": "vp fmt . --check",
    "prepare": "effect-tsgo patch --typescript --oxlint"
  },
  "devDependencies": {
    "@effect/tsgo": "0.69.0",
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@12.21.0"
}
